boot_splash/image="uid://frf3m3jj31do"
config/icon="uid://bs85cw4f7pn8a"
boot_splash/minimum_display_time=300

[autoload]

VersionUtils="*uid://2k12dqeaqgns"
SceneManager="*uid://bi3g1pahafani"
PopupManager="*uid://cc7fw4nxe6bvv"

[display]

window/size/viewport_width=1920
